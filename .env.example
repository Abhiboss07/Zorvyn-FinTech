# ═══════════════════════════════════════════════════════════
# Zorvyn FinTech — Environment Configuration
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════

# ── Server ──
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zorvyn_fintech
SPRING_DATASOURCE_USERNAME=zorvyn
SPRING_DATASOURCE_PASSWORD=zorvyn_secret_2024

# ── MongoDB Atlas ──
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zorvyn_audit?retryWrites=true&w=majority

# ── Redis ──
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── JWT ──
JWT_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
JWT_EXPIRATION_MS=900000
JWT_REFRESH_SECRET=f0e1d2c3b4a5f6e7d8c9b0a1f2e3d4c5b6a7f8e9d0c1b2a3f4e5d6c7b8a9f0e1
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Encryption (AES-256-GCM) ──
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_PREVIOUS=

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Rate Limiting ──
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION_MINUTES=15
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_DURATION_MINUTES=15
